# Copy to .env and fill in the platforms you want to enable.
# Platforms with missing credentials are reported as "failed" in the response;
# the remaining platforms are still posted to.

# 1. Mastodon  (Preferences > Development > New application, scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 2. Bluesky  (Settings > App Passwords)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# 3. Telegram  (create a bot with @BotFather, add it as admin of a PUBLIC channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# 4. DEV Community  (Settings > Extensions > DEV Community API Keys)
DEVTO_API_KEY=

# 5. GitHub Gist  (fine-grained/classic token with "gist" scope)
GITHUB_TOKEN=

# 6. Discord  (Channel > Integrations > Webhooks > Copy Webhook URL)
DISCORD_WEBHOOK_URL=
